{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server,shared,drizzle}/**/*"
    }
  },
  "rewrites": [
    {
      "source": "/manus-storage/:path*",
      "destination": "/api/index?__path=manus-storage/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    },
    {
      "source": "/:path((?!api/|manus-storage/).*)",
      "destination": "/index.html"
    }
  ]
}
